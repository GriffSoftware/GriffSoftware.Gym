<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GriffGym.Application\GriffGym.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The persistence records and repositories are internal on purpose: nothing outside this
         assembly should be able to touch an EF entity. The tests are the exception. -->
    <InternalsVisibleTo Include="GriffGym.TestSupport" />
    <InternalsVisibleTo Include="GriffGym.Infrastructure.Tests" />
    <InternalsVisibleTo Include="GriffGym.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Google.Apis.Auth" />
  </ItemGroup>

</Project>
